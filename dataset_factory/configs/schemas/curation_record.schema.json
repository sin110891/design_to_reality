        "material_relationship": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Relationship"
        },
        "lighting_strategy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lighting Strategy"
        },
        "proportion_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proportion Rule"
        },
        "circulation_strategy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Circulation Strategy"
        },
        "visual_hierarchy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visual Hierarchy"
        },
        "appropriate_room_conditions": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Appropriate Room Conditions",
          "type": "array"
        }
      },
      "required": [
        "why_it_works"
      ],
      "title": "PositiveDesignKnowledge",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "ingested",
        "draft",
        "validation_failed",
        "reviewed",
        "approved",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SourceType": {
      "enum": [
        "local_folder",
        "studio",
        "licensed",
        "unknown"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "UsageRightsStatus": {
      "enum": [
        "unknown",
        "internal_reference_only",
        "licensed_for_analysis",
        "licensed_for_training",
        "studio_owned",
        "permission_granted",
        "restricted"
      ],
      "title": "UsageRightsStatus",
      "type": "string"
    }
  },
  "properties": {
    "record_id": {
